# DhanMool Backend Configuration
SUPABASE_URL="https://gnvimwprlfbhltmnibwt.supabase.co"

# CRITICAL SECURITY NOTE:
# Use the service_role key for backend operations so that PostgreSQL Row-Level Security (RLS)
# can be safely enabled to block unauthorized public access from the anon key.
# Get this from: https://supabase.com/dashboard/project/gnvimwprlfbhltmnibwt/settings/api
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"

# Application JWT secret for user session authentication
JWT_SECRET_KEY="your-secure-jwt-secret-key-at-least-32-chars"

# Optional: Gemini API Key for AI Financial Advisor
GEMINI_API_KEY=""

# Optional: Set to true to enable Swagger documentation (/docs)
ENABLE_DOCS="false"
